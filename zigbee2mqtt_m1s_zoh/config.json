{
  "name": "Zigbee2MQTT M1S ZoH Stable",
  "version": "0.1.5",
  "slug": "zigbee2mqtt_m1s_zoh",
  "description": "Zigbee2MQTT 2.14.2 cu ZoH 0.2.4-m1s.2: reparare sigura a adreselor scurte",
  "stage": "experimental",
  "uart": true,
  "udev": true,
  "startup": "application",
  "services": [
    "mqtt:need"
  ],
  "hassio_api": true,
  "arch": [
    "aarch64",
    "amd64"
  ],
  "boot": "auto",
  "watchdog": "tcp://[HOST]:[PORT:8099]",
  "init": false,
  "ingress": true,
  "timeout": 30,
  "panel_icon": "mdi:zigbee",
  "map": [
    {
      "type": "share",
      "read_only": false
    },
    {
      "type": "homeassistant_config",
      "read_only": false,
      "path": "/config"
    },
    {
      "type": "app_config",
      "read_only": false,
      "path": "/addon_config"
    },
    {
      "type": "ssl",
      "read_only": true
    }
  ],
  "ports": {
    "8485/tcp": null,
    "8099/tcp": null
  },
  "ports_description": {
    "8485/tcp": "Socat tcp-listen port",
    "8099/tcp": "Frontend tcp-listen port"
  },
  "ingress_port": 8099,
  "options": {
    "data_path": "/config/zigbee2mqtt",
    "socat": {
      "enabled": false,
      "master": "pty,raw,echo=0,link=/tmp/ttyZ2M,mode=777",
      "slave": "tcp-listen:8485,keepalive,nodelay,reuseaddr,keepidle=1,keepintvl=1,keepcnt=5",
      "options": "-d -d",
      "log": false
    },
    "mqtt": {},
    "serial": {},
    "coordinator_readiness": {
      "enabled": true,
      "username": "admin",
      "password": "",
      "expected_mac": ""
    }
  },
  "schema": {
    "data_path": "str",
    "socat": {
      "enabled": "bool?",
      "master": "str?",
      "slave": "str?",
      "options": "str?",
      "log": "bool?"
    },
    "mqtt": {
      "server": "str?",
      "ca": "str?",
      "key": "str?",
      "cert": "str?",
      "user": "str?",
      "password": "str?",
      "base_topic": "str?"
    },
    "serial": {
      "port": "str?",
      "adapter": "match(zoh|zstack|deconz|zigate|ezsp|ember|zboss)?",
      "baudrate": "int?",
      "rtscts": "bool?"
    },
    "watchdog": "str?",
    "coordinator_readiness": {
      "enabled": "bool?",
      "username": "str?",
      "password": "password?",
      "expected_mac": "str?"
    },
    "force_onboarding": "bool?"
  }
}
